#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only)

echo "Running biome check on staged files..."
npx biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true
if [ $? -ne 0 ]; then
	echo "Biome check failed."
	exit 1
fi

echo "Running type checking and fast tests..."
npm run typecheck && npm run test:precommit
if [ $? -ne 0 ]; then
	echo "Checks failed."
	exit 1
fi

# CI typechecks web-ui and packages/desktop separately, and the root tsconfig
# covers neither. Without these, a type error in either package passes
# pre-commit and only fails once it reaches CI. Skipped when the package has
# no node_modules, so a root-only checkout can still commit.
for pkg in web-ui packages/desktop; do
	if [ -d "$pkg/node_modules" ]; then
		echo "Type checking $pkg..."
		npm --prefix "$pkg" run typecheck
		if [ $? -ne 0 ]; then
			echo "$pkg typecheck failed."
			exit 1
		fi
	fi
done

for file in $STAGED_FILES; do
	if [ -f "$file" ]; then
		git add "$file"
	fi
done

echo "Pre-commit checks passed."
